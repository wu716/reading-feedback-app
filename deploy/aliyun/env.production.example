# 复制为 deploy/aliyun/.env 或项目根 .env 后填写

# === 必填 ===
DEEPSEEK_API_KEY=sk-xxxxxxxx
SECRET_KEY=请生成至少32位随机字符串
ENVIRONMENT=production

# === 数据库（docker-compose 内置 PostgreSQL）===
POSTGRES_USER=reading_app
POSTGRES_PASSWORD=请设置强密码
POSTGRES_DB=reading_feedback
# 若使用阿里云 RDS，改为：
# DATABASE_URL=postgresql://用户名:密码@rm-xxx.pg.rds.aliyuncs.com:5432/reading_feedback

# === 邮件（推荐阿里云 DirectMail 或腾讯企业邮）===
# DirectMail SMTP 示例：
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=465
# SMTP_USE_TLS=true
# SMTP_USERNAME=控制台发信地址
# SMTP_PASSWORD=SMTP 密码
# SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# === 域名与端口 ===
APP_PORT=8000
CORS_ORIGINS=https://yourdomain.com
