# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# === 开发环境 ===
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
# 生产必须换成至少 32 位随机串，不要用示例默认值
SECRET_KEY=请生成至少32位随机字符串
ENVIRONMENT=development
DATABASE_URL=sqlite:///./app.db

# === 生产环境（阿里云）额外配置 ===
# ENVIRONMENT=production
# DATABASE_URL=postgresql://user:pass@rm-xxx.pg.rds.aliyuncs.com:5432/reading_feedback
# CORS_ORIGINS=https://yourdomain.com

# === 邮件提醒（阿里云 DirectMail 示例）===
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=465
# SMTP_USE_TLS=true
# SMTP_USERNAME=noreply@yourdomain.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# === 可选 ===
# PORT=8000

# === 注册与 AI 额度 ===
# 注册需一次性 4 位邀请码（站长后台生成）。REGISTRATION_OPEN=false 可紧急关闭。
# 旧的 INVITE_CODE 不再作为共享注册码校验。
# REGISTRATION_OPEN=true
# AI_DAILY_LIMIT=3
# AI_EXTRACT_DAILY_LIMIT=2
